# build output
psp/bin/
build/
*.o
*.a
*.elf
*.prx
*.PBP

# never: game data, converted packs, your settings and logs
*.pak
*.mpq
*.MPQ
wowee.cfg
session.log

# SandstoneDebug sources (the generic lib/ and Makefile rules above must not hide them)
!psp/sandstone-debug/lib/
!psp/sandstone-debug/lib/Makefile
!psp/sandstone-debug/prx/Makefile

# Personal XMB art generated from the local client by Kiln
/psp/xmb/*.PNG

# Extracted client content is local input, never source for a PR.
/Data/expansions/*/*
!/Data/expansions/*/*.json
/logs/
__pycache__/
*.py[cod]

/Data/expansions/*/manifest.json

# Upstream's separately restricted original music is not redistributed.
/assets/Original Music/
